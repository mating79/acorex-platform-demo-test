{
  "name": "user-management",
  "title": "User Management",
  "aggregates": [
    {
      "name": "user-aggregate",
      "title": "User Aggregate",
      "entities": [
        {
          "name": "user",
          "title": "User",
          "type": 1,
          "fields": [
            {
              "name": "id",
              "title": "User ID",
              "description": "Unique identifier for the user",
              "schema": "uuid",
              "features": {
                "nullable": false,
                "readOnly": true
              }
            },
            {
              "name": "email",
              "title": "Email Address",
              "description": "User's email address",
              "schema": "email",
              "features": {
                "nullable": false,
                "readOnly": false
              },
              "validations": [
                {
                  "rule": "required"
                },
                {
                  "rule": "email"
                }
              ]
            },
            {
              "name": "firstName",
              "title": "First Name",
              "description": "User's first name",
              "schema": "text-short",
              "features": {
                "nullable": false,
                "readOnly": false
              },
              "validations": [
                {
                  "rule": "required"
                },
                {
                  "rule": "minLength",
                  "options": {
                    "value": 2
                  }
                }
              ]
            },
            {
              "name": "lastName",
              "title": "Last Name",
              "description": "User's last name",
              "schema": "text-short",
              "features": {
                "nullable": false,
                "readOnly": false
              },
              "validations": [
                {
                  "rule": "required"
                },
                {
                  "rule": "minLength",
                  "options": {
                    "value": 2
                  }
                }
              ]
            },
            {
              "name": "phone",
              "title": "Phone Number",
              "description": "User's phone number",
              "schema": "phone",
              "features": {
                "nullable": true,
                "readOnly": false
              }
            },
            {
              "name": "dateOfBirth",
              "title": "Date of Birth",
              "description": "User's date of birth",
              "schema": "date",
              "features": {
                "nullable": true,
                "readOnly": false
              }
            },
            {
              "name": "isActive",
              "title": "Active Status",
              "description": "Whether the user account is active",
              "schema": "boolean",
              "features": {
                "nullable": false,
                "readOnly": false
              },
              "defaultValue": true
            },
            {
              "name": "createdAt",
              "title": "Created Date",
              "description": "When the user account was created",
              "schema": "datetime",
              "features": {
                "nullable": false,
                "readOnly": true
              }
            }
          ]
        },
        {
          "name": "user-profile",
          "title": "User Profile",
          "type": 0,
          "fields": [
            {
              "name": "userId",
              "title": "User ID",
              "description": "Reference to the user",
              "schema": "uuid",
              "features": {
                "nullable": false,
                "readOnly": true
              }
            },
            {
              "name": "avatar",
              "title": "Avatar",
              "description": "User profile picture",
              "schema": "image-url",
              "features": {
                "nullable": true,
                "readOnly": false
              }
            },
            {
              "name": "bio",
              "title": "Biography",
              "description": "User's bio or description",
              "schema": "text-long",
              "features": {
                "nullable": true,
                "readOnly": false
              }
            },
            {
              "name": "website",
              "title": "Website",
              "description": "User's personal or professional website",
              "schema": "url",
              "features": {
                "nullable": true,
                "readOnly": false
              }
            },
            {
              "name": "preferences",
              "title": "User Preferences",
              "description": "User's application preferences",
              "schema": "json-object",
              "features": {
                "nullable": true,
                "readOnly": false
              }
            }
          ]
        }
      ],
      "relations": [
        {
          "type": "OneToOne",
          "source": {
            "entity": "user",
            "key": "id"
          },
          "target": {
            "aggregate": "user-management",
            "entity": "user-profile",
            "key": "userId"
          },
          "isRequired": true
        }
      ],
      "validations": [],
      "actions": [
        {
          "event": "user.created",
          "side": "server",
          "expression": "createUserProfile(user.id)"
        },
        {
          "event": "user.deleted",
          "side": "server",
          "expression": "deleteUserProfile(user.id)"
        }
      ]
    }
  ]
}
