# Origin of the ACoreX Platform API (no trailing slash).
# Dev server proxies /api and /socket.io here so HttpOnly cookies stay first-party.
API_ORIGIN=http://localhost:5500

# Set to true when API_ORIGIN is HTTPS and the dev proxy fails with
# "unable to verify the first certificate" (writes secure: false to proxy.conf.json).
# API_PROXY_INSECURE=true

# Public path the Angular app uses for HTTP + realtime.
# Keep /api when using the local proxy (recommended).
API_BASE_PATH=/api

# Optional absolute API URL (skips same-origin /api).
# Only use this when the backend allows CORS credentials for this app origin.
# API_PUBLIC_BASE_URL=https://example.acorex.io/api
