{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "cli": {
    "analytics": false,
    "packageManager": "npm"
  },
  "newProjectRoot": "projects",
  "projects": {
    "demo": {
      "projectType": "application",
      "root": "",
      "sourceRoot": "src",
      "prefix": "acorex-platform",
      "architect": {
        "build": {
          "builder": "@angular/build:application",
          "options": {
            "outputPath": "dist/demo",
            "index": "src/index.html",
            "browser": "src/main.ts",
            "polyfills": ["zone.js"],
            "tsConfig": "tsconfig.app.json",
            "assets": [
              {
                "glob": "**/*",
                "input": "src/assets",
                "output": "/assets"
              },
              {
                "glob": "**/*",
                "input": "node_modules/@acorex-platform/extension-weather-core-client/assets/images/weather",
                "output": "/assets/images/weather"
              },
              "src/favicon.ico"
            ],
            "styles": [
              "src/assets/fonts/font-icon/font-awesome/css/fontawesome.min.css",
              "src/assets/fonts/font-icon/font-awesome/css/brands.min.css",
              "src/assets/fonts/font-icon/font-awesome/css/light.min.css",
              "src/assets/fonts/font-icon/font-awesome/css/solid.min.css",
              "src/styles.css"
            ],
            "scripts": [],
            "allowedCommonJsDependencies": [
              "html2canvas",
              "dom-to-image",
              "lodash",
              "qrcode",
              "leaflet",
              "quill-delta-to-html",
              "memoizee",
              "quill-delta"
            ]
          },
          "configurations": {
            "production": {
              "optimization": true,
              "outputHashing": "all",
              "sourceMap": false,
              "extractLicenses": true
            },
            "development": {
              "optimization": false,
              "sourceMap": {
                "scripts": true,
                "styles": false
              }
            }
          },
          "defaultConfiguration": "production"
        },
        "serve": {
          "builder": "@angular/build:dev-server",
          "options": {
            "port": 4800,
            "host": "0.0.0.0",
            "proxyConfig": "proxy.conf.json"
          },
          "configurations": {
            "development": {
              "buildTarget": "demo:build:development"
            },
            "production": {
              "buildTarget": "demo:build:production"
            }
          },
          "defaultConfiguration": "development"
        }
      }
    }
  }
}
